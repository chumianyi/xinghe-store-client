<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.xinghe.store"
    android:versionCode="1"
    android:versionName="1.0.0">

    <uses-sdk android:minSdkVersion="3" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:name="com.xinghe.store.XingheApp"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name="com.xinghe.store.Xinghe"
            android:configChanges="keyboardHidden|orientation"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name="com.xinghe.store.AppDetails"
            android:configChanges="keyboardHidden|orientation" />
        <activity android:name="com.xinghe.store.SearchActivity"
            android:configChanges="keyboardHidden|orientation" />
        <activity android:name="com.xinghe.store.RankingActivity"
            android:configChanges="keyboardHidden|orientation" />
        <activity android:name="com.xinghe.store.LoginActivity"
            android:configChanges="keyboardHidden|orientation" />
        <activity android:name="com.xinghe.store.RegisterActivity"
            android:configChanges="keyboardHidden|orientation" />
        <activity android:name="com.xinghe.store.ProfileActivity"
            android:configChanges="keyboardHidden|orientation" />
        <activity android:name="com.xinghe.store.MessagesActivity"
            android:configChanges="keyboardHidden|orientation" />
        <activity android:name="com.xinghe.store.SubmitActivity"
            android:configChanges="keyboardHidden|orientation" />
        <activity android:name="com.xinghe.store.FavoritesActivity"
            android:configChanges="keyboardHidden|orientation" />
        <activity android:name="com.xinghe.store.HistoryActivity"
            android:configChanges="keyboardHidden|orientation" />
        <activity android:name="com.xinghe.store.SettingsActivity"
            android:configChanges="keyboardHidden|orientation" />

    </application>
</manifest>
